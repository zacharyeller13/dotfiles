/*
 * Tokyonight rofi theme
 * Clean, modern take on the classic palette
 */

* {
    /* Tokyonight colors */
    bg:        rgba(26, 27, 38, 0.92);
    bg-alt:    rgba(36, 40, 59, 0.90);
    bg-hover:  rgba(41, 46, 66, 0.95);
    fg:        #c0caf5;
    fg-dim:    #565f89;
    blue:      #7aa2f7;
    purple:    #bb9af7;
    cyan:      #7dcfff;
    black:     #15161e;
    bdr:       rgba(59, 66, 97, 0.85);

    /* Globals */
    background-color: transparent;
    text-color:       @fg;
    font:             "monospace 11";
}

window {
    width:    560px;
    location: center;
    anchor:   north;

    background-color: @bg;
    border:           1px;
    border-color:     @bdr;
    border-radius:    14px;
    padding:          14px;

    transparency: "real";
}

mainbox {
    spacing:  8px;
    children: [ inputbar, message, listview ];
}

/* Search bar */
inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          8px;

    children: [ prompt, entry ];
}

prompt {
    text-color: @blue;
    font:       "monospace 12";
}

entry {
    cursor:           pointer;
    placeholder:      "Search...";
    placeholder-color: @fg-dim;
}

/* Results list */
listview {
    lines:         12;
    columns:       1;
    spacing:       3px;
    fixed-height:  false;
    dynamic:       true;
    scrollbar:     false;

    border-radius: 10px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       8px;
}

element-icon {
    size: 18px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element normal.active {
    text-color: @cyan;
}

element normal.urgent {
    text-color: @purple;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @blue;
    text-color:       @black;
}

element selected.normal element-icon,
element selected.active element-icon,
element selected.urgent element-icon {
    background-color: transparent;
}

/* Not currently shown, but styled if modes are enabled */
button {
    padding:          8px 12px;
    background-color: @bg-alt;
    text-color:       @fg-dim;
    border-radius:    8px;
}

button selected.normal {
    background-color: @bg-hover;
    text-color:       @fg;
}

/* Message / mode switcher bar */
message {
    margin:        4px 0 0 0;
    padding:       10px 14px;
    border-radius: 10px;
    background-color: @bg-alt;
}

textbox {
    text-color: @fg-dim;
}
